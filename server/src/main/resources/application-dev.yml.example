spring:
  datasource:
    url: jdbc:mariadb://localhost:3306/adulto_funcional
    username: 
    password: 

jwt:
  secret: 
  expiration: 900000
  issuer: adulto-funcional-server
  audience: adulto-funcional-clients

auth:
  session:
    refresh-expiration: 2592000000
    replay-window-seconds: 5
    refresh-token-bytes: 32

master-key:
  session:
    ttl: 3600000

APP_COOKIE_SECURE: false
APP_COOKIE_SAME_SITE: Lax
CORS_ALLOWED_ORIGINS: http://localhost:5173
