# MariaDB
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=agenda
MARIADB_USER=
MARIADB_PASSWORD=

# JWT y sesiones de Master Key
JWT_SECRET=change_me_jwt_secret_with_32_chars_minimum
JWT_EXPIRATION=86400000
MASTER_KEY_SESSION_SECRET=change_me_master_key_session_secret_with_32_chars_minimum

# Redis (para sesiones de Master Key en producción)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# CORS y cookies
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
