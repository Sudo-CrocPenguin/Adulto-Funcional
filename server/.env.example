# MariaDB
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=agenda
MARIADB_USER=
MARIADB_PASSWORD=

# Genera cada secreto por separado con: openssl rand -base64 32
# Nunca reutilices el mismo valor entre JWT, Master Key, Redis y MariaDB.
JWT_SECRET=
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=2592000000
MASTER_KEY_SESSION_SECRET=

# Redis (para sesiones de Master Key en producción)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS y cookies
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
