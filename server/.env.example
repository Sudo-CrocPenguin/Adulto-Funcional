# Nombre estable del proyecto Compose. En server1 usa adulto-funcional-prod.
COMPOSE_PROJECT_NAME=adulto-funcional

# MariaDB
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=agenda
MARIADB_USER=
MARIADB_PASSWORD=

# Genera cada secreto por separado con: openssl rand -base64 32
# Nunca reutilices el mismo valor entre JWT, Master Key, Redis y MariaDB.
JWT_SECRET=
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=2592000000
MASTER_KEY_SESSION_SECRET=

# Redis (para sesiones de Master Key en producción)
REDIS_HOST=adulto-funcional-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS y cookies
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_HTTP_MAX_REQUEST_BODY_SIZE=1MB
APP_DEFAULT_TIME_ZONE=America/Bogota
APP_JOBS_ENABLED=true
APP_FIXED_EXPENSE_CRON=0 5 * * * *
APP_FIXED_EXPENSE_BATCH_SIZE=100
APP_FIXED_EXPENSE_MAX_BATCHES=10

# Publicación local del backend. Conserva loopback salvo que se necesite LAN.
SERVER_HOST_ADDRESS=127.0.0.1
SERVER_HOST_PORT=8080

# Solo se usa con docker-compose.coolify.yml.
COOLIFY_NETWORK=coolify
API_PUBLIC_HOST=api.example.com
