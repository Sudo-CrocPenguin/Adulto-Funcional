{
  "expo": {
    "name": "Adulto Funcional",
    "slug": "adulto-funcional",
    "version": "0.1.0",
    "description": "Organizacion personal de finanzas, agenda y credenciales.",
    "scheme": "adultofuncional",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adultofuncional.mobile"
    },
    "android": {
      "package": "com.adultofuncional.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
